{
  "name": "Naija-Agent-Core-Template",
  "description": "Infrastructure for Naija Agent Core (API, Zynux, Aelixxr, Redis)",
  "argumentOverrides": {
    "PROJECT_NAME": "naija-agent-core",
    "PROJECT_REGION": "europe-west",
    "GIT_REPO": "https://github.com/LightBoy01/naija-agent-core",
    "GIT_BRANCH": "master"
  },
  "projects": [
    {
      "name": "${args.PROJECT_NAME}",
      "region": "${args.PROJECT_REGION}",
      "description": "Production environment",
      "addons": [
        {
          "name": "naija-agent-redis",
          "type": "redis",
          "version": "7",
          "billing": {
            "deploymentPlan": "nf-addon-xs"
          }
        }
      ],
      "services": [
        {
          "name": "naija-agent-api",
          "description": "Public API Gateway",
          "billing": {
            "deploymentPlan": "nf-compute-xs"
          },
          "vcsData": {
            "projectType": "github",
            "projectUrl": "${args.GIT_REPO}",
            "projectBranch": "${args.GIT_BRANCH}"
          },
          "buildSettings": {
            "dockerfile": {
              "dockerFilePath": "/Dockerfile",
              "dockerWorkDir": "/"
            }
          },
          "deployment": {
            "instances": 1,
            "ports": [
              {
                "name": "http",
                "port": 3000,
                "protocol": "HTTP",
                "public": true
              }
            ],
            "startup": {
              "command": "npm start",
              "workingDirectory": "/apps/api"
            }
          },
          "environmentVariables": [
            {
              "name": "NODE_ENV",
              "value": "production"
            }
          ],
          "dependsOn": ["naija-agent-redis"]
        }
      ],
      "jobs": [
        {
          "name": "naija-agent-worker",
          "description": "Zynux Business Engine",
          "jobType": "daemon",
          "billing": {
            "deploymentPlan": "nf-compute-xs"
          },
          "vcsData": {
            "projectType": "github",
            "projectUrl": "${args.GIT_REPO}",
            "projectBranch": "${args.GIT_BRANCH}"
          },
          "buildSettings": {
            "dockerfile": {
              "dockerFilePath": "/Dockerfile",
              "dockerWorkDir": "/"
            }
          },
          "deployment": {
            "instances": 1,
            "startup": {
              "command": "npm start",
              "workingDirectory": "/apps/worker"
            }
          },
          "environmentVariables": [
            {
              "name": "NODE_ENV",
              "value": "production"
            }
          ],
          "dependsOn": ["naija-agent-redis"]
        },
        {
          "name": "naija-agent-worker-life",
          "description": "Aelixxr Life Engine",
          "jobType": "daemon",
          "billing": {
            "deploymentPlan": "nf-compute-xs"
          },
          "vcsData": {
            "projectType": "github",
            "projectUrl": "${args.GIT_REPO}",
            "projectBranch": "${args.GIT_BRANCH}"
          },
          "buildSettings": {
            "dockerfile": {
              "dockerFilePath": "/Dockerfile",
              "dockerWorkDir": "/"
            }
          },
          "deployment": {
            "instances": 1,
            "startup": {
              "command": "npm start",
              "workingDirectory": "/apps/worker-life"
            }
          },
          "environmentVariables": [
            {
              "name": "NODE_ENV",
              "value": "production"
            }
          ],
          "dependsOn": ["naija-agent-redis"]
        }
      ]
    }
  ]
}