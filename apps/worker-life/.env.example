# Redis Connection (Life Engine)
REDIS_URL_LOS=redis://default:PASSWORD@redis-los-host:port
# Fallback to standard Redis if LOS specific one is not set
REDIS_URL=redis://localhost:6379

# AI Configuration (Life Engine)
# Use a separate key for LOS to segregate costs and rate limits
GEMINI_API_KEY_LOS=your_gemini_api_key_here
GEMINI_MODEL_LOS=gemini-1.5-pro-latest

# Logging
LOG_LEVEL=info

# Scraper Config
PUPPETEER_HEADLESS=true
