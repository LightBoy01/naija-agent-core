{
  "name": "naija-agent-core",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf apps/*/dist packages/*/dist apps/*/.tsbuildinfo packages/*/.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "build": "npm run clean && node scripts/build.js",
    "vercel-build": "npm run clean && node ./node_modules/typescript/bin/tsc -b packages/types packages/database packages/firebase packages/payments packages/storage packages/logistics packages/ai && npm run build --workspace=web",
    "dev": "npm run dev --workspaces",
    "start": "npm run start --workspaces",
    "start:api": "node apps/api/dist/index.js",
    "start:workers": "node scripts/start-unified-workers.mjs",
    "start:worker": "node apps/worker/dist/index.js",
    "start:worker-life": "node apps/worker-life/dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "0.20.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "bcrypt": "^6.0.0",
    "bytes": "3.1.2",
    "cookie": "^1.1.1",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "depd": "2.0.0",
    "http-errors": "2.0.1",
    "iconv-lite": "0.7.2",
    "inherits": "2.0.4",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "proxy-agent": "^5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "setprototypeof": "1.2.0",
    "statuses": "2.0.2",
    "toidentifier": "1.0.1",
    "unpipe": "1.0.0"
  }
}
