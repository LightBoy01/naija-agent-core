# ============================================
# Naija Agent Core — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Node ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/naija_agent

# --- Redis (at least one required) ---
REDIS_URL=redis://localhost:6379
# REDIS_URL_LOS=redis://localhost:6379

# --- AI / Gemini (at least one variant required) ---
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY_STUDIO=your-studio-key
# GEMINI_API_KEY_LOS=your-life-os-key

# --- WhatsApp ---
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
# WHATSAPP_API_TOKEN=your-whatsapp-api-token
# WHATSAPP_PHONE_ID=your-whatsapp-phone-id

# --- Payments (optional) ---
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
# MONNIFY_SECRET_KEY=sk_live_xxx
# MONNIFY_API_KEY=xxx
# MONNIFY_CONTRACT_CODE=xxx

# --- API Security (optional, recommended for production) ---
# API_KEY=your-api-key
# CRON_SECRET=your-cron-secret
# SIDECAR_API_KEY=your-sidecar-api-key

# --- Model overrides (optional) ---
# GEMINI_MODEL_LOS=deepseek-v4-pro

# --- Web Dashboard (for CORS) ---
# WEB_DASHBOARD_URL=https://dashboard.yourdomain.com

# --- Feature Flags ---
# DISABLE_BILLING=true

# --- Object Storage (optional) ---
# CLOUDFLARE_R2_ACCOUNT_ID=xxx
# CLOUDFLARE_R2_ACCESS_KEY_ID=xxx
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxx
# CLOUDFLARE_R2_BUCKET=xxx

# --- Firebase (legacy bridge, optional) ---
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
