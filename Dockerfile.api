# --- Stage 1: API Builder ---
FROM node:20-bookworm AS builder

WORKDIR /app

# Minimal build tools (No Go, No Python needed for API)
RUN apt-get update && apt-get install -y curl build-essential && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development

# Monorepo Dependency Optimization
COPY package.json package-lock.json ./
COPY packages/ packages/
COPY apps/api/package.json apps/api/

# Pre-install Node dependencies
RUN npm install

# Copy source and build
COPY . .
RUN npm run build

# --- Stage 2: API Serverless Runner ---
FROM node:20-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production

# Copy built artifacts from builder
COPY --from=builder /app /app

# Expose API port
EXPOSE 3000

# Start only the API
CMD ["npm", "run", "start:api"]
